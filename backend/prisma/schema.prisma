generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector]
}

model User {
  id               String        @id @default(uuid())
  user_name        String?
  email            String        @unique
  profile_pic_link String?
  name             String
  emailVerified    Boolean       @default(false)
  image            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  sessions         Session[]
  accounts         Account[]
  events           Event[]
  photos           Photo[]
  participant      Participant[]
  referenceFaces    ReferenceFace[] 	

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testField String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  driveApproved         Boolean   @default(true)
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Event {
  id            String   @id @default(uuid())
  eventName     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  driveApproved Boolean  @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  photos Photo[] @relation("EventPhotos")

  thumbnailId String? @unique
  thumbnail   Photo?  @relation("EventThumbnail", fields: [thumbnailId], references: [id])

  photoCount  Int           @default(0)
  participant Participant[]
  referenceFaces    ReferenceFace[] 	
  invitelink  InviteLink?

  @@unique([eventName, userId])
  @@index([userId])
  @@map("event")
}

model Photo {
  id          String   @id @default(uuid())
  photo_url   String
  public_id   String   @unique
  width       Int?
  height      Int?
  uploaded_at DateTime @default(now())
  uploaded_by String
  event_id    String
  embedding   Unsupported("vector(512)")?

  event       Event  @relation("EventPhotos", fields: [event_id], references: [id], onDelete: Cascade)
  user        User   @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
  thumbnailOf Event? @relation("EventThumbnail")

  @@index([event_id])
  @@map("photo")
}

model Participant {
  id        String    @id @default(uuid())
  eventId   String
  userId    String
  joinedAt  DateTime  @default(now())
  revokedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique(name : "eventId_userId" , [eventId, userId])
  @@map("participant")
}

model InviteLink {
  id        String    @id @default(uuid())
  token     String    @unique @default(cuid())
  eventId   String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId])
  @@map("invitelink")
}

model ReferenceFace {
  id          String   @id @default(uuid())

  photo_url   String
  public_id   String   @unique

  eventId     String
  userId       String
  width       Int?
  height      Int?
  embedding   Unsupported("vector(512)")?

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@unique(name : "eventId_userId" , [eventId, userId])
  @@map("reference_face")
}

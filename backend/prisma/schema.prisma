generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(uuid())
  user_name        String?
  email            String          @unique
  profile_pic_link String?
  name             String
  emailVerified    Boolean         @default(false)
  image            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  accounts         Account[]
  events           Event[]
  participant      Participant[]
  photos           Photo[]
  referenceFaces   ReferenceFace[]
  sessions         Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  testField String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  issuer                String
  accessToken           String?
  refreshToken          String?
  driveApproved         Boolean   @default(true)
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Event {
  id             String          @id @default(uuid())
  eventName      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  driveApproved  Boolean         @default(true)
  userId         String
  thumbnailId    String?         @unique
  photoCount     Int             @default(0)
  thumbnail      Photo?          @relation("EventThumbnail", fields: [thumbnailId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitelink     InviteLink?
  participant    Participant[]
  photos         Photo[]         @relation("EventPhotos")
  referenceFaces ReferenceFace[]

  @@unique([eventName, userId])
  @@index([userId])
  @@map("event")
}

model Photo {
  id              String                 @id @default(uuid())
  photo_url       String
  public_id       String                 @unique
  width           Int?
  height          Int?
  uploaded_at     DateTime               @default(now())
  uploaded_by     String
  event_id        String
  embedding       Unsupported("vector")?
  status          ProcessingStatus       @default(PENDING)
  retry_count     Int                    @default(0)
  statusUpdatedAt DateTime?
  thumbnailOf     Event?                 @relation("EventThumbnail")
  event           Event                  @relation("EventPhotos", fields: [event_id], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
  faces           PhotoFace[]

  @@index([event_id])
  @@index([id, status])
  @@map("photo")
}

model Participant {
  id        String    @id @default(uuid())
  eventId   String
  userId    String
  joinedAt  DateTime  @default(now())
  revokedAt DateTime?
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], name: "eventId_userId")
  @@map("participant")
}

model InviteLink {
  id        String    @id @default(uuid())
  token     String    @unique @default(cuid())
  eventId   String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("invitelink")
}

model ReferenceFace {
  id              String                 @id @default(uuid())
  photo_url       String
  public_id       String                 @unique
  eventId         String
  userId          String
  width           Int?
  height          Int?
  embedding       Unsupported("vector")?
  createdAt       DateTime               @default(now())
  status          ProcessingStatus       @default(PENDING)
  retry_count     Int                    @default(0)
  statusUpdatedAt DateTime?
  event           Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], name: "eventId_userId")
  @@index([id, status])
  @@map("reference_face")
}

model PhotoFace {
  id         String                @id @default(uuid())
  photo_id   String
  face_index Int
  embedding  Unsupported("vector")
  bbox       Json?
  det_score  Float?
  createdAt  DateTime              @default(now())
  photo      Photo                 @relation(fields: [photo_id], references: [id], onDelete: Cascade)

  @@index([photo_id])
  @@map("photo_face")
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}
